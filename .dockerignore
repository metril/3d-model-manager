# Build context is the repo root (the image needs both backend/ and web/).
# Keep this list roughly mirroring .gitignore plus test-only backend dirs
# that have no business in the runtime image.

.git/
.superpowers/

# Python
**/__pycache__/
**/*.py[cod]
backend/.venv/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/tests/
backend/tests_e2e/

# Node
web/node_modules/
web/dist/

# App runtime (host-side bind mounts / volumes, never baked into the image)
data/
library/

# Repo content no build stage COPYs. The image is built from backend/, web/
# and docker/ only, so everything here is pure upload cost on every build
# (and a spurious cache-busting context change whenever it's edited):
# - extension/  unbundled MV3 browser extension, shipped as a Release zip
# - docs/       specs and design notes
# - scripts/    host-side helpers (fetch-gltfpack.sh, e2e.sh,
#               bambu_postprocess.py) -- the image builds gltfpack from
#               source in its own stage and never shells out to these
# - .github/    CI definitions
# - compose*.yaml  deployment topology, consumed by the Compose CLI
extension/
docs/
scripts/
.github/
compose*.yaml

# Env/secrets
*.env
.env.*
!.env.example

# Editors/OS
.idea/
.vscode/
.DS_Store

# Added: more upload-cost / cache-busting paths no build stage COPYs.
# (slicer/ and docker/orcaslicer/ are built from their OWN contexts, so
# ignoring them here is safe; docker/ itself is NOT ignored: the Dockerfile
# COPYs docker/entrypoint.sh.)
**/node_modules/
.playwright-mcp/
.claude/
slicer/
slicer-watch/
*-exchange/
docker/orcaslicer/
/*.md
backend/.tools/
backend/data/
backend/library/
