#!/usr/bin/with-contenv bash
# Upgrade from the Bambu Studio image: a persisted /config keeps the old
# labwc/openbox autostart (the base only seeds it when absent), which still
# launches /opt/bambustudio/AppRun. Replace any such file with the image default.
CFG="${ORCASLICER_CFG_DIR:-/config}"
DEF="${ORCASLICER_DEFAULTS_DIR:-/defaults}"
swap() {  # <user autostart> <default>
  if [ -f "$1" ] && grep -q bambustudio "$1" && [ -f "$2" ]; then
    cp "$2" "$1"
    chown abc:abc "$1" 2>/dev/null || true
    echo "[orcaslicer-autostart] replaced stale Bambu Studio autostart $1"
  fi
}
swap "$CFG/.config/labwc/autostart" "$DEF/autostart_wayland"
swap "$CFG/.config/openbox/autostart" "$DEF/autostart"
