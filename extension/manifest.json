{
  "manifest_version": 3,
  "name": "3D Model Manager",
  "version": "0.10.0",
  "description": "Save MakerWorld, Thingiverse, and Printables models to your self-hosted 3D Model Manager library, and keep your MakerWorld cookie synced.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "tdmm-extension@metril.github.io",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "contextMenus",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://www.makerworld.com/*",
    "https://thingiverse.com/*",
    "https://www.thingiverse.com/*",
    "https://printables.com/*",
    "https://www.printables.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Save to my library",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "src/options.html"
}
